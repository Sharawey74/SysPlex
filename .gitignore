# System Monitor - Git Ignore

# ============================================
# Runtime Data (DO NOT COMMIT)
# ============================================

# JSON logs and metrics
json/*.json
!json/.gitkeep

# Reports (generated at runtime)
reports/html/*.html
reports/markdown/*.md
!reports/html/.gitkeep
!reports/markdown/.gitkeep

# Host monitoring output
Host/output/*.json
Host/output/temp/
!Host/output/.gitkeep

# Host2 (Go agent) build output
# NOTE: build.sh produces host-agent-{linux,macos,windows.exe}. The previous
# patterns said "host2-agent-*" and therefore never matched anything, which is
# how 24 MB of binaries reached the history. Binaries ship as GitHub Release
# assets instead - see adr/0007-binaries-via-releases.md
Host2/bin/host-agent-*
Host2/bin/go_latest.json
!Host2/bin/.gitkeep

# Data files (generated at runtime)
# NOTE: patterns containing a slash are anchored to this file's directory, so
# these do NOT cover windows/data/. That subtree is listed explicitly below.
data/logs/*.log
data/metrics/*.json
data/alerts/*.json

# PowerShell agent runtime state (the tree itself is removed in Phase 1)
windows/data/
!data/logs/.gitkeep
!data/metrics/.gitkeep
!data/alerts/.gitkeep

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
~*
*.bak
*.backup

# ============================================
# OS Specific
# ============================================
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ============================================
# IDE Files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
PIPFILE.lock
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Virtual environments
venv/
env/
ENV/
.venv

# ============================================
# Go
# ============================================
# Compiled binaries are already excluded above in Host2/bin/

# ============================================
# Docker
# ============================================
# Keep docker-compose.yml but ignore overrides
docker-compose.override.yml

# ============================================
# Logs
# ============================================
*.log
logs/
/tmp/
*.pid

# ============================================
# Vendored third-party binaries
# ============================================
# Fetched by windows/scripts/setup_libs.ps1, not committed.
# LibreHardwareMonitor is MPL-2.0; redistributing the binary carries
# attribution obligations this repo does not satisfy.
libs/*.dll

# ============================================
# Frontend (Phase 7)
# ============================================
node_modules/
dist/
.vite/
*.tsbuildinfo

# ============================================
# Environment
# ============================================
.env
.env.*
!.env.example
*.local

# ============================================
# Personal working files (not project documentation)
# ============================================
# plans/ and adr/ ARE tracked - they are the record of why this system looks
# the way it does. Only these two are personal.
TASKS.md
memory/

# ============================================
# Keep Important Files
# ============================================
!libs/README.md
!docs/README.md
!data/logs/.gitkeep
!data/metrics/.gitkeep
!data/alerts/.gitkeep
!json/.gitkeep
!reports/html/.gitkeep
!reports/markdown/.gitkeep
!Host/output/.gitkeep
!Host2/bin/.gitkeep
